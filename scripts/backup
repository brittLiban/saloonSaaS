#!/usr/bin/env sh
set -eu

BACKUP_DIR="${BACKUP_DIR:-backups}"
STAMP="$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"

docker compose exec -T postgres pg_dump \
  -U "${POSTGRES_USER:-glasshound}" \
  -d "${POSTGRES_DB:-glasshound}" \
  > "$BACKUP_DIR/postgres-$STAMP.sql"

echo "Wrote $BACKUP_DIR/postgres-$STAMP.sql"
echo "Object storage backup is deployment-specific; copy the minio-data volume or mirror the bucket separately."
