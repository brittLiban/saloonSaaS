    "seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "bullmq": "5.65.1",
    "ioredis": "5.8.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "postcss": "8.5.14"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
